# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist/
/tmp/
/out-tsc/
/bazel-out/

# Node
/node_modules/
npm-debug.log
yarn-error.log

# all directories starting with a dot
/.*/
# except for
!/.husky/
!/.github/

# IDEs and editors
.project
.classpath
*.launch
*.sublime-workspace

# Miscellaneous
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Auto-generated at build time — do not commit (regenerated by postinstall / prebuild)
src/app/git-version.auto.ts
