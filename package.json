{
  "name": "shngadmin",
  "version": "1.12.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production && cp dist/static/3rdpartylicenses.txt src/assets/3rdpartylicenses.txt",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "extract": "ngx-translate-extract --input ./src --output ./src/assets/i18n/template-{de,en,fr}.json --clean --format namespaced-json",
    "i18n:init": "ngx-translate-extract --input ./src --output ./src/assets/i18n/template.json --key-as-default-value --replace --format json",
    "i18n:extract": "ngx-translate-extract --input ./src --output ./src/assets/i18n/{en,da,de,fi,nb,nl,sv}.json --clean --format json",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,json}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.20",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.20",
    "@angular/compiler": "^20.3.20",
    "@angular/core": "^20.3.20",
    "@angular/forms": "^20.3.20",
    "@angular/localize": "^20.3.20",
    "@angular/platform-browser": "^20.3.20",
    "@angular/platform-browser-dynamic": "^20.3.20",
    "@angular/router": "^20.3.20",
    "@auth0/angular-jwt": "5.1.0",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@fontsource/roboto": "^5.2.10",
    "@fortawesome/angular-fontawesome": "^2.0.1",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^16.0.1",
    "@primeuix/themes": "^2.0.3",
    "chart.js": "^4.5.1",
    "core-js": "^3.41.0",
    "file-saver": "^2.0.5",
    "js-sha512": "^0.8.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "^7.8.2",
    "tslib": "2.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.18",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vendure/ngx-translate-extract": "^9.4.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.1.5",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "5.8.3"
  }
}
