{
  "name": "shngadmin",
  "version": "0.9.18",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "cypress open",
    "extract": "ngx-translate-extract --input ./src --output ./src/assets/i18n/template-{de,en,fr}.json --clean --format namespaced-json",
